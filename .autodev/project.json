{
  "schemaVersion": 1,
  "project": {
    "id": "festplan",
    "displayName": "FestPlan",
    "repository": "LPStruiksma/festplan",
    "defaultBranch": "main",
    "trustedDevelopmentBranches": [
      "main"
    ]
  },
  "authority": {
    "autonomyMode": "auto-merge-low-risk",
    "automationBranchPrefix": "claude/",
    "protectedBranches": [
      "main"
    ],
    "humanOnly": [
      "production-credentials",
      "production-deployment",
      "production-data-destructive-migration",
      "production-database-apply",
      "oauth-provider-console-configuration",
      "external-service-spend",
      "user-personal-data"
    ],
    "forbiddenPaths": [
      ".env",
      ".env.local",
      ".env.*",
      "supabase/.temp",
      ".vercel"
    ]
  },
  "state": {
    "requiredDocs": [
      "DEVELOPMENT_REPORT.md",
      "package.json",
      "vite.config.js",
      ".gitignore"
    ],
    "recentDocGroups": [],
    "excludedPaths": [
      "node_modules",
      "dist",
      "supabase/.temp",
      ".vercel"
    ],
    "maxCharsPerDocument": 40000,
    "maxTotalChars": 120000,
    "minHeadroomChars": 20000,
    "maxRecentCommits": 24
  },
  "commands": {
    "check": "npm ci --ignore-scripts && npm test && npm run build",
    "lint": "npm run lint"
  },
  "review": {
    "enabled": true,
    "maxCorrectionLoops": 2,
    "configPath": null,
    "captureCommand": null
  },
  "budgets": {
    "maxAutonomousTransitionsPerCycle": 8,
    "maxModelCostUsdPerCycle": 2,
    "maxWallClockMinutesPerCycle": 60,
    "maxRetriesPerTransition": 1
  },
  "promotion": {
    "requireChecks": true,
    "requireIndependentReview": true,
    "allowDirectProtectedBranchWrite": false,
    "autoMergeCategories": [
      "routine"
    ],
    "humanMergePaths": [
      ".github/**",
      ".autodev/**",
      "vercel.json",
      "supabase/migrations/**",
      "AGENTS.md",
      "CLAUDE.md",
      ".claude/**",
      ".mcp.json"
    ],
    "authoritySensitivePaths": []
  }
}
